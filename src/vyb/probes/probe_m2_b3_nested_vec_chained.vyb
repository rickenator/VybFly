// probe_m2_b3_nested_vec_chained - Vec<Vec<Int>>: does a chained member call on an index
// read (`outer.get(i).push(x)`) work, or does it hit the Vec-return chained-call codegen
// fault family?
//
// Run: VYB_STDLIB=$HOME/Projects/Vyb/stdlib $HOME/Projects/Vyb/build/vyb \
//        src/vyb/probes/probe_m2_b3_nested_vec_chained.vyb

main()<Int> -> {
    buckets<Vec<Vec<Int>>> = Vec()
    i<Int> = 0
    while (i < 4) {
        inner<Vec<Int>> = Vec()
        buckets.push(inner)
        i = i + 1
    }
    buckets.get(1).push(33)
    println("inner1_len=" + buckets.get(1).len().to_string())
    println("probe-b3-done")
    return 0
}
