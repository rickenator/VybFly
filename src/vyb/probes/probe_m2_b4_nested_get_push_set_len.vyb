// probe_m2_b4_nested_get_push_set_len - the smallest slice of the b1 pattern that does NOT
// chain a method onto a get() return:  get -> push -> set -> get -> len.
//
// Run: VYB_STDLIB=$HOME/Projects/Vyb/stdlib $HOME/Projects/Vyb/build/vyb \
//        src/vyb/probes/probe_m2_b4_nested_get_push_set_len.vyb

main()<Int> -> {
    buckets<Vec<Vec<Int>>> = Vec()
    i<Int> = 0
    while (i < 4) {
        inner<Vec<Int>> = Vec()
        buckets.push(inner)
        i = i + 1
    }
    println("outer_len=" + buckets.len().to_string())
    b1<Vec<Int>> = buckets.get(1)
    b1.push(11)
    b1.push(12)
    buckets.set(1, b1)
    b2<Vec<Int>> = buckets.get(1)
    println("inner1_len=" + b2.len().to_string())
    println("probe-b4-done")
    return 0
}
