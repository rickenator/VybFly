// phase2_des.vyb - end-to-end LIF neural network simulation driven by the M2 Vyb DES runtime.
// (PROJECT-VYBFLY.md §8 "Phase 2 - Vyb Discrete-Event Runtime"; docs/VYB-PORT.md milestone V3.)
//
// The DES mechanism lives in des.vyb (bucketed calendar-queue scheduler, structure-of-arrays entity
// state, delivery sink, recorder, event source, replication/experiment types). This program supplies
// what is application-specific: the connectivity (CSR out-edges), the entity parameters loaded from
// the tiny-net fixture, the temporal drive (stimulus EventSource) and the scatter step that turns
// each spike into future synaptic events. Nothing here re-implements scheduling.
//
// The fixture (data/processed/tiny_net/) is generated by scripts/make_tiny_net.py; the independent
// Python oracle in scripts/vyb_des_check.py reimplements the same semantics from the same files and
// compares spike trains exactly. Units and the full semantics contract are documented in des.vyb's
// header, in the fixture headers and in vyb_des_check.py's docstring.
//
// Run:
//   VYB_STDLIB=~/Projects/Vyb/stdlib ~/Projects/Vyb/build/vyb \
//     src/vyb/phase2_des.vyb --module-path src/vyb
//
// @env: VYB_STDLIB=stdlib

import des::{
    Sched, Delivery, EntityState, Recorder, EventSource, Replication, Experiment,
    sched_new_for_horizon, sched_push, drain_tick,
    delivery_new,
    ent_new, ent_init, ent_fired_at,
    lif_leak, kernel_tick, rec_new, rec_finalize, rec_total, rec_ptr, rec_tick_at,
    rec_hash_canonical,
    src_from, src_len, src_pump_all,
    replication_new, experiment_new,
    event_type_stimulus, event_type_synaptic, timestamp_ticks_per_ms,
    json_int, json_str, json_int_last, json_str_last, des_status_message
}

import io::{open_write, close, write_str, open_read, read_all}
import time::{time_mono_millis, time_epoch_secs}

// ---------------------------------------------------------------------------------------------
// Fixture paths and the experiment configuration
// ---------------------------------------------------------------------------------------------

fixture_dir()<String> -> { return "data/processed/tiny_net/" }
out_dir()<String> -> { return "results/phase2/" }

invocation()<String> -> {
    return "VYB_STDLIB=~/Projects/Vyb/stdlib ~/Projects/Vyb/build/vyb src/vyb/phase2_des.vyb --module-path src/vyb"
}

experiment_name()<String> -> { return "m2-tiny-lif-des" }

// bucket slack: the ring must cover max_delay ticks beyond the horizon
sched_slack()<Int> -> { return 16 }

// ---------------------------------------------------------------------------------------------
// Small CSV / text helpers (String.to_int does not exist on this build: probe_m2_c)
// ---------------------------------------------------------------------------------------------

// Parse the first decimal integer in `s`, stopping at the first non-digit (leading '-' honored).
parse_int(s<String>)<Int> -> {
    n<Int> = s.len()
    i<Int> = 0
    sign<Int> = 1
    v<Int> = 0
    digits<Int> = 0
    while (i < n) {
        c<Int> = (s.char_at(i) as Int) & 0xFF
        if (c == 45) {
            sign = -1
        } else {
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48)
                digits = digits + 1
            } else {
                i = n
            }
        }
        i = i + 1
    }
    if (digits == 0) { return 0 }
    return v * sign
}

// k-th comma-separated field of a line, parsed as an integer.
field_int(line<String>, k<Int>)<Int> -> {
    parts<Vec<String>> = line.split(",")
    if (k < 0 || k >= parts.len()) { return 0 }
    return parse_int(parts.get(k))
}

is_comment(line<String>)<Int> -> {
    t<String> = line.trim()
    if (t.len() == 0) { return 1 }
    if (t.starts_with("#")) { return 1 }
    return 0
}

read_text(path<String>)<String> -> {
    match (open_read(path)) {
        f -> {
            match (read_all(f)) {
                s -> {
                    close(f)
                    return s
                }
                ? -> {
                    close(f)
                    return ""
                }
            }
        }
        ? -> { return "" }
    }
}

write_text(path<String>, body<String>)<Int> -> {
    match (open_write(path)) {
        f -> {
            write_str(f, body)
            close(f)
            return 1
        }
        ? -> { return 0 }
    }
}

host_name()<String> -> {
    t<String> = read_text("/etc/hostname").trim()
    if (t.len() == 0) { return "unknown" }
    return t
}

// ---------------------------------------------------------------------------------------------
// Fixture loading
// ---------------------------------------------------------------------------------------------

struct NetParams {
    n<Int>,
    etype<Vec<Int>>,
    tau_ticks<Vec<Int>>,
    decay_k<Vec<Int>>,
    refr_ticks<Vec<Int>>,
    threshold<Vec<Int>>,
    vrest<Vec<Int>>,
    vreset<Vec<Int>>
}

struct Graph {
    n<Int>,
    m<Int>,
    max_delay<Int>,
    indptr<Vec<Int>>,
    post<Vec<Int>>,
    delay<Vec<Int>>,
    weight<Vec<Int>>
}

struct ReplicationTable {
    n<Int>,
    name<Vec<String>>,
    stream<Vec<Int>>,
    ticks<Vec<Int>>
}

// neurons.csv: index,label,type,tau_ticks,decay_k,refr_ticks,vth,vrest,vreset
load_net_params(path<String>)<NetParams> -> {
    p<NetParams> = NetParams { n = 0, etype = Vec(), tau_ticks = Vec(), decay_k = Vec(),
                               refr_ticks = Vec(), threshold = Vec(), vrest = Vec(), vreset = Vec() }
    rows<Vec<String>> = read_text(path).split("\n")
    header<Int> = 0
    i<Int> = 0
    while (i < rows.len()) {
        line<String> = rows.get(i)
        if (is_comment(line) == 0) {
            if (header == 0) {
                header = 1
            } else {
                parts<Vec<String>> = line.split(",")
                if (parts.len() >= 9) {
                    idx<Int> = parse_int(parts.get(0))
                    if (idx == p.n) {
                        if (parts.get(2) == "E") { p.etype.push(0) } else { p.etype.push(1) }
                        p.tau_ticks.push(parse_int(parts.get(3)))
                        p.decay_k.push(parse_int(parts.get(4)))
                        p.refr_ticks.push(parse_int(parts.get(5)))
                        p.threshold.push(parse_int(parts.get(6)))
                        p.vrest.push(parse_int(parts.get(7)))
                        p.vreset.push(parse_int(parts.get(8)))
                        p.n = p.n + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return p
}

// edges.csv: edge,pre,post,delay_ticks,weight,nt  (sorted by (pre, post))
load_graph(path<String>)<Graph> -> {
    rows<Vec<String>> = read_text(path).split("\n")
    g<Graph> = Graph { n = 0, m = 0, max_delay = 0, indptr = Vec(), post = Vec(), delay = Vec(),
                       weight = Vec() }
    // pass 1: row count per pre
    header<Int> = 0
    counts<Vec<Int>> = Vec()
    i<Int> = 0
    while (i < rows.len()) {
        line<String> = rows.get(i)
        if (is_comment(line) == 0) {
            if (header == 0) {
                header = 1
            } else {
                pre<Int> = field_int(line, 1)
                while (counts.len() <= pre) { counts.push(0) }
                counts.set(pre, counts.get(pre) + 1)
                g.m = g.m + 1
            }
        }
        i = i + 1
    }
    g.n = counts.len()
    // prefix sums -> row pointers
    k<Int> = 0
    acc<Int> = 0
    while (k < g.n) {
        g.indptr.push(acc)
        acc = acc + counts.get(k)
        k = k + 1
    }
    g.indptr.push(acc)
    // allocate the edge columns, then fill in file order (already (pre, post) sorted)
    i = 0
    while (i < g.m) {
        g.post.push(0)
        g.delay.push(0)
        g.weight.push(0)
        i = i + 1
    }
    cursor<Vec<Int>> = Vec()
    k = 0
    while (k < g.n) {
        cursor.push(g.indptr.get(k))
        k = k + 1
    }
    header = 0
    i = 0
    while (i < rows.len()) {
        line<String> = rows.get(i)
        if (is_comment(line) == 0) {
            if (header == 0) {
                header = 1
            } else {
                parts<Vec<String>> = line.split(",")
                if (parts.len() >= 5) {
                    pre<Int> = parse_int(parts.get(1))
                    if (pre >= 0 && pre < g.n) {
                        c<Int> = cursor.get(pre)
                        dl<Int> = parse_int(parts.get(3))
                        if (c >= 0 && c < g.m) {
                            g.post.set(c, parse_int(parts.get(2)))
                            g.delay.set(c, dl)
                            g.weight.set(c, parse_int(parts.get(4)))
                            cursor.set(pre, c + 1)
                        }
                        if (dl > g.max_delay) { g.max_delay = dl }
                    }
                }
            }
        }
        i = i + 1
    }
    return g
}

// stimulus_sN.csv: tick,target,weight -> an EventSource
load_source(path<String>, kind<Int>)<EventSource> -> {
    ticks<Vec<Int>> = Vec()
    target<Vec<Int>> = Vec()
    value<Vec<Int>> = Vec()
    rows<Vec<String>> = read_text(path).split("\n")
    header<Int> = 0
    i<Int> = 0
    while (i < rows.len()) {
        line<String> = rows.get(i)
        if (is_comment(line) == 0) {
            if (header == 0) {
                header = 1
            } else {
                parts<Vec<String>> = line.split(",")
                if (parts.len() >= 3) {
                    ticks.push(parse_int(parts.get(0)))
                    target.push(parse_int(parts.get(1)))
                    value.push(parse_int(parts.get(2)))
                }
            }
        }
        i = i + 1
    }
    return src_from(kind, ticks, target, value)
}

// replications.csv: name,stimulus_stream,horizon_ticks
load_replications(path<String>)<ReplicationTable> -> {
    t<ReplicationTable> = ReplicationTable { n = 0, name = Vec(), stream = Vec(), ticks = Vec() }
    rows<Vec<String>> = read_text(path).split("\n")
    header<Int> = 0
    i<Int> = 0
    while (i < rows.len()) {
        line<String> = rows.get(i)
        if (is_comment(line) == 0) {
            if (header == 0) {
                header = 1
            } else {
                parts<Vec<String>> = line.split(",")
                if (parts.len() >= 3) {
                    t.name.push(parts.get(0).trim())
                    t.stream.push(parse_int(parts.get(1)))
                    t.ticks.push(parse_int(parts.get(2)))
                    t.n = t.n + 1
                }
            }
        }
        i = i + 1
    }
    return t
}

pick_source(src0<EventSource>, src1<EventSource>, stream<Int>)<EventSource> -> {
    if (stream == 1) { return src1 }
    return src0
}

// ---------------------------------------------------------------------------------------------
// Output files for one replication
// ---------------------------------------------------------------------------------------------

// Canonical spike record: entity-major, tick-ascending (independent of within-tick update order).
write_spikes(path<String>, rec<their<Recorder>>, n<Int>) -> {
    match (open_write(path)) {
        f -> {
            write_str(f, "# canonical spike record: entity-major, tick-ascending. columns: entity,tick\n")
            write_str(f, "entity,tick\n")
            i<Int> = 0
            while (i < n) {
                lo<Int> = rec_ptr(rec, i)
                hi<Int> = rec_ptr(rec, i + 1)
                k<Int> = lo
                while (k < hi) {
                    write_str(f, i.to_string() + "," + rec_tick_at(rec, k).to_string() + "\n")
                    k = k + 1
                }
                i = i + 1
            }
            close(f)
        }
        ? -> { }
    }
}

// Per-entity aggregates over the canonical record, including a tick checksum.
write_counts(path<String>, rec<their<Recorder>>, nps<NetParams>) -> {
    match (open_write(path)) {
        f -> {
            write_str(f, "# per-entity spike aggregates over the canonical (entity-major) record\n")
            write_str(f, "entity,type,spikes,first_tick,last_tick,tick_sum\n")
            i<Int> = 0
            while (i < nps.n) {
                lo<Int> = rec_ptr(rec, i)
                hi<Int> = rec_ptr(rec, i + 1)
                first<Int> = -1
                last<Int> = -1
                sum<Int> = 0
                k<Int> = lo
                while (k < hi) {
                    tk<Int> = rec_tick_at(rec, k)
                    if (k == lo) { first = tk }
                    last = tk
                    sum = sum + tk
                    k = k + 1
                }
                tname<String> = "I"
                if (nps.etype.get(i) == 0) { tname = "E" }
                write_str(f, i.to_string() + "," + tname + "," + (hi - lo).to_string() + ","
                              + first.to_string() + "," + last.to_string() + "," + sum.to_string() + "\n")
                i = i + 1
            }
            close(f)
        }
        ? -> { }
    }
}

// ---------------------------------------------------------------------------------------------
// One replication: DES-driven LIF integration over the tiny network
// ---------------------------------------------------------------------------------------------

run_replication(nps<NetParams>, gph<Graph>, src<EventSource>, rname<String>, stream<Int>,
                horizon<Int>)<Replication> -> {
    t_start<Int> = time_mono_millis()
    r<Replication> = replication_new(rname, stream, horizon)

    st<EntityState> = ent_new(nps.n)
    i<Int> = 0
    while (i < nps.n) {
        ent_init(borrow(st), i, nps.etype.get(i), nps.tau_ticks.get(i), nps.decay_k.get(i),
                 nps.refr_ticks.get(i), nps.threshold.get(i), nps.vrest.get(i), nps.vreset.get(i))
        i = i + 1
    }
    rec<Recorder> = rec_new(nps.n)
    sc<Sched> = sched_new_for_horizon(horizon, gph.max_delay + sched_slack())
    d<Delivery> = delivery_new()

    // EventSource -> Scheduler: the external schedule is primed up front.
    primed<Int> = src_pump_all(borrow(sc), borrow(src), horizon)

    t_sim<Int> = time_mono_millis()
    ticks<Int> = 0
    max_batch<Int> = 0
    beyond<Int> = 0
    while (true) {
        t<Int> = drain_tick(borrow(sc), borrow(d))
        if (t < 0) { break }
        if (t >= horizon) {
            // unreachable for a well-formed schedule (the source and the scatter both filter on the
            // horizon); counted so a violation is visible rather than silent
            beyond = beyond + 1
            break
        }
        nf<Int> = kernel_tick(borrow(st), borrow(rec), borrow(d), t)
        if (d.n > max_batch) { max_batch = d.n }
        // scatter: every spike becomes one event per out-edge, delay >= 1 tick
        q<Int> = 0
        while (q < nf) {
            eidx<Int> = ent_fired_at(borrow(st), q)
            e<Int> = gph.indptr.get(eidx)
            e_end<Int> = gph.indptr.get(eidx + 1)
            while (e < e_end) {
                nt<Int> = t + gph.delay.get(e)
                if (nt < horizon) {
                    sched_push(borrow(sc), nt, gph.post.get(e), event_type_synaptic(),
                               gph.weight.get(e))
                }
                e = e + 1
            }
            q = q + 1
        }
        ticks = ticks + 1
    }
    r.sim_ms = time_mono_millis() - t_sim
    r.wall_ms = time_mono_millis() - t_start

    rec_finalize(borrow(rec))
    write_spikes(out_dir() + "vyb_spikes_" + rname + ".csv", borrow(rec), nps.n)
    write_counts(out_dir() + "vyb_counts_" + rname + ".csv", borrow(rec), nps)

    r.spikes = rec_total(borrow(rec))
    r.events_scheduled = sc.total_pushed
    r.events_processed = sc.total_popped
    r.stimulus_events = sc.by_kind.get(event_type_stimulus())
    r.synaptic_events = sc.by_kind.get(event_type_synaptic())
    r.ticks_processed = ticks
    r.max_batch = max_batch
    r.spike_hash = rec_hash_canonical(borrow(rec), nps.n)
    r.sched_buckets = sc.n_buckets
    r.sched_turns = sc.ticks_advanced
    r.sched_grows = sc.grows
    r.sched_recycles = sc.recycles
    r.sched_late = sc.late_events
    r.sched_far = sc.far_events
    r.sched_max_bucket = sc.max_bucket_len
    r.sched_arena_high = sc.arena_high
    r.beyond_horizon = beyond
    r.determinism_ok = 1
    if (beyond != 0) { r.determinism_ok = 0 }
    if (sc.late_events != 0) { r.determinism_ok = 0 }
    if (sc.far_events != 0) { r.determinism_ok = 0 }

    println("replication " + rname + ": stream=" + stream.to_string()
            + " horizon_ticks=" + horizon.to_string() + " spikes=" + r.spikes.to_string()
            + " events_scheduled=" + r.events_scheduled.to_string()
            + " events_processed=" + r.events_processed.to_string()
            + " ticks_processed=" + ticks.to_string()
            + " max_batch=" + max_batch.to_string()
            + " buckets=" + sc.n_buckets.to_string()
            + " turns_advanced=" + sc.ticks_advanced.to_string()
            + " ring_grows=" + sc.grows.to_string()
            + " arena_slots=" + sc.ev_time.len().to_string()
            + " arena_high=" + sc.arena_high.to_string()
            + " recycles=" + sc.recycles.to_string()
            + " max_bucket_len=" + sc.max_bucket_len.to_string()
            + " late=" + sc.late_events.to_string()
            + " far=" + sc.far_events.to_string()
            + " beyond=" + beyond.to_string()
            + " primed=" + primed.to_string()
            + " sim_ms=" + r.sim_ms.to_string()
            + " wall_ms=" + r.wall_ms.to_string()
            + " spike_hash=" + r.spike_hash.to_string())
    return r
}

replication_json(r<Replication>, last<Int>)<String> -> {
    tail<String> = "},\n"
    if (last == 1) { tail = "}\n" }
    s<String> = "    {\n"
    s = s + json_str("name", r.name)
    s = s + json_int("stream", r.stream)
    s = s + json_int("horizon_ticks", r.horizon)
    s = s + json_int("spikes", r.spikes)
    s = s + json_int("events_scheduled", r.events_scheduled)
    s = s + json_int("events_processed", r.events_processed)
    s = s + json_int("stimulus_events", r.stimulus_events)
    s = s + json_int("synaptic_events", r.synaptic_events)
    s = s + json_int("ticks_processed", r.ticks_processed)
    s = s + json_int("max_batch", r.max_batch)
    s = s + json_int("sim_ms", r.sim_ms)
    s = s + json_int("wall_ms", r.wall_ms)
    s = s + json_int("spike_hash", r.spike_hash)
    s = s + json_int_last("determinism_ok", r.determinism_ok)
    return s + "    " + tail
}

// ---------------------------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------------------------

main()<Int> -> {
    t_boot<Int> = time_mono_millis()
    println(des_status_message())

    nps<NetParams> = load_net_params(fixture_dir() + "neurons.csv")
    gph<Graph> = load_graph(fixture_dir() + "edges.csv")
    src0<EventSource> = load_source(fixture_dir() + "stimulus_s0.csv", event_type_stimulus())
    src1<EventSource> = load_source(fixture_dir() + "stimulus_s1.csv", event_type_stimulus())
    rt<ReplicationTable> = load_replications(fixture_dir() + "replications.csv")
    load_ms<Int> = time_mono_millis() - t_boot

    println("fixture: neurons=" + nps.n.to_string() + " edges=" + gph.m.to_string()
            + " max_delay=" + gph.max_delay.to_string()
            + " stimulus_s0=" + src_len(borrow(src0)).to_string()
            + " stimulus_s1=" + src_len(borrow(src1)).to_string()
            + " replications=" + rt.n.to_string()
            + " load_ms=" + load_ms.to_string())

    main_ticks<Int> = 0
    short_ticks<Int> = 0
    k<Int> = 0
    while (k < rt.n) {
        if (rt.name.get(k) == "main") { main_ticks = rt.ticks.get(k) }
        if (rt.name.get(k) == "det_a") { short_ticks = rt.ticks.get(k) }
        k = k + 1
    }
    window<Int> = main_ticks + gph.max_delay + sched_slack()

    blocks<String> = ""
    hashes<Vec<Int>> = Vec()
    names<Vec<String>> = Vec()
    spikes_by_name<Vec<Int>> = Vec()
    total_spikes<Int> = 0
    total_events<Int> = 0
    total_late<Int> = 0
    total_far<Int> = 0
    total_grows<Int> = 0
    total_recycles<Int> = 0
    total_turns<Int> = 0
    total_max_bucket<Int> = 0
    main_sim_ms<Int> = 0
    main_wall_ms<Int> = 0
    main_events<Int> = 0
    main_spikes<Int> = 0

    k = 0
    while (k < rt.n) {
        rname<String> = rt.name.get(k)
        stream<Int> = rt.stream.get(k)
        horizon<Int> = rt.ticks.get(k)
        src<EventSource> = pick_source(src0, src1, stream)
        r<Replication> = run_replication(nps, gph, src, rname, stream, horizon)

        last<Int> = 0
        if (k == rt.n - 1) { last = 1 }
        blocks = blocks + replication_json(r, last)
        hashes.push(r.spike_hash)
        names.push(rname)
        spikes_by_name.push(r.spikes)
        total_spikes = total_spikes + r.spikes
        total_events = total_events + r.events_scheduled
        total_late = total_late + r.sched_late
        total_far = total_far + r.sched_far
        total_grows = total_grows + r.sched_grows
        total_recycles = total_recycles + r.sched_recycles
        total_turns = total_turns + r.sched_turns
        if (r.sched_max_bucket > total_max_bucket) { total_max_bucket = r.sched_max_bucket }
        if (rname == "main") {
            main_sim_ms = r.sim_ms
            main_wall_ms = r.wall_ms
            main_events = r.events_scheduled
            main_spikes = r.spikes
        }
        k = k + 1
    }

    // determinism: two replications of the same configuration must agree bit for bit
    det_a<Int> = 0
    det_b<Int> = 0
    det_a_spikes<Int> = 0
    det_b_spikes<Int> = 0
    found_a<Int> = 0
    found_b<Int> = 0
    k = 0
    while (k < names.len()) {
        if (names.get(k) == "det_a") {
            det_a = hashes.get(k); det_a_spikes = spikes_by_name.get(k); found_a = 1
        }
        if (names.get(k) == "det_b") {
            det_b = hashes.get(k); det_b_spikes = spikes_by_name.get(k); found_b = 1
        }
        k = k + 1
    }
    det_ok<Int> = 0
    if (found_a == 1 && found_b == 1 && det_a == det_b && det_a_spikes == det_b_spikes) { det_ok = 1 }

    events_per_s<Int> = 0
    spikes_per_s<Int> = 0
    if (main_sim_ms > 0) {
        events_per_s = (main_events * 1000) / main_sim_ms
        spikes_per_s = (main_spikes * 1000) / main_sim_ms
    }
    bio_ms<Int> = main_ticks / timestamp_ticks_per_ms()
    bio_ms_per_wall_s<Int> = 0
    if (main_wall_ms > 0) { bio_ms_per_wall_s = (bio_ms * 1000) / main_wall_ms }
    events_per_bio_s<Int> = 0
    if (bio_ms > 0) { events_per_bio_s = (main_events * 1000) / bio_ms }

    body<String> = "{\n"
    body = body + json_str("schema", "flyscale.phase2.des_summary/1")
    body = body + json_str("milestone", "M2 - Vyb discrete-event runtime (PROJECT-VYBFLY.md 8)")
    body = body + json_str("experiment", experiment_name())
    body = body + json_str("vyb_invocation", invocation())
    body = body + json_str("vyb_stdlib", "VYB_STDLIB=~/Projects/Vyb/stdlib")
    body = body + json_str("vyb_module_path", "src/vyb")
    body = body + json_str("fixture", fixture_dir())
    body = body + json_str("host", host_name())
    body = body + json_int("load_ms", load_ms)
    body = body + json_int("wall_ms_total", time_mono_millis() - t_boot)
    body = body + json_int("n_neurons", nps.n)
    body = body + json_int("n_edges", gph.m)
    body = body + json_int("max_delay_ticks", gph.max_delay)
    body = body + json_int("n_replications", rt.n)
    body = body + json_int("primary_horizon_ticks", main_ticks)
    body = body + json_int("short_horizon_ticks", short_ticks)
    body = body + json_int("scheduler_buckets", window)
    body = body + json_int("scheduler_bucket_width_ticks", 1)
    body = body + json_int("tick_micros", 100)
    body = body + json_int("bio_ms", bio_ms)
    body = body + json_int("bio_ms_per_wall_second", bio_ms_per_wall_s)
    body = body + json_int("primary_spikes", main_spikes)
    body = body + json_int("primary_events_scheduled", main_events)
    body = body + json_int("primary_events_per_wall_second", events_per_s)
    body = body + json_int("primary_spikes_per_wall_second", spikes_per_s)
    body = body + json_int("primary_events_per_bio_second", events_per_bio_s)
    body = body + json_int("primary_sim_ms", main_sim_ms)
    body = body + json_int("primary_wall_ms", main_wall_ms)
    body = body + json_int("total_spikes_all_replications", total_spikes)
    body = body + json_int("total_events_all_replications", total_events)
    body = body + json_int("total_late_events", total_late)
    body = body + json_int("total_far_events", total_far)
    body = body + json_int("total_ring_grows", total_grows)
    body = body + json_int("total_recycles", total_recycles)
    body = body + json_int("total_bucket_turns_advanced", total_turns)
    body = body + json_int("max_bucket_len", total_max_bucket)
    body = body + json_int("determinism_ok", det_ok)
    body = body + json_int("det_a_spike_hash", det_a)
    body = body + json_int("det_b_spike_hash", det_b)
    body = body + json_int("det_a_spikes", det_a_spikes)
    body = body + json_int("det_b_spikes", det_b_spikes)
    body = body + "  \"replications\": [\n" + blocks + "  ]\n}\n"
    wrote<Int> = write_text(out_dir() + "des_summary.json", body)

    println("des_summary_written=" + wrote.to_string())
    println("determinism_ok=" + det_ok.to_string())
    println("primary: spikes=" + main_spikes.to_string() + " events=" + main_events.to_string()
            + " sim_ms=" + main_sim_ms.to_string() + " wall_ms=" + main_wall_ms.to_string()
            + " events_per_s=" + events_per_s.to_string()
            + " bio_ms=" + bio_ms.to_string()
            + " bio_ms_per_wall_s=" + bio_ms_per_wall_s.to_string())
    println("phase2-des-done")
    return 0
}
