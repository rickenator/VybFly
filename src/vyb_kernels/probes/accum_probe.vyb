// Isolate accumulate_bucket (the one kernel not yet proven correct in isolation).
//
// update_and_fire now passes its selftest with the fixed compiler, but the whole-pipeline gate
// still fails: the GPU fires 10 neurons at tick 0 (the seed count) where the CPU reference and an
// independent numpy recomputation both fire 3 (neurons 9, 10, 11). That points at the accumulated
// input, so this runner launches accumulate_bucket ONCE with the seed bucket and reads the
// accumulator back.
//
// Expected accumulator (g = 0.02, ring offsets 1/3/7, synapse count 3+d, negated for i % 5 == 0),
// in micro-units, target -> value:
//    1:-80000   2:+80000   3:-40000   4:+200000  5:+200000  6:+40000   7:0
//    8:+160000  9:+400000 10:+400000 11:+320000 12:0       13..16:+200000   0:0
// Build the kernels first (results/phase3/spike_bucket.ptx already exists from the pipeline run):
//   VYB_STDLIB=... vyb --kernel src/vyb_kernels/spike_bucket.vyb --ptx results/phase3/spike_bucket.ptx
// Run:
//   VYB_STDLIB=~/Projects/Vyb-fix270/stdlib vyb src/vyb_kernels/probes/accum_probe.vyb \
//       --module-path ~/Projects/Vyb-fix270/bindings \
//       --module-path ~/Projects/Vyb-fix270/bindings/cuda
import cuda::{cuda_init, cuda_device_count, cuda_device, cuda_ctx_retain, cuda_module_load,
              cuda_module_func, cuda_mem_alloc, cuda_write_i32, cuda_write_f64, cuda_read_f64,
              cuda_launch, cuda_sync}
import io::{open_read, read_all}

desc_word(dst<Int>, off<Int>, value<Int>)<Int> -> {
    low<Int> = value % 4294967296
    high<Int> = value / 4294967296
    cuda_write_i32(dst + off, low as CInt)
    cuda_write_i32(dst + off + 4, high as CInt)
    return 0
}

main()<Int> -> {
    n<Int> = 512
    n_seed<Int> = 10
    n_slots<Int> = 32
    g_micro<Int> = 20000

    cuda_init()
    if (cuda_device_count() < 1) { println("ERROR no device"); return 8 }
    dev<Int> = cuda_device(0) as Int
    cuda_ctx_retain(dev)

    ptx<String> = ""
    match (open_read("results/phase3/spike_bucket.ptx")) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { println("ERROR read ptx"); return 13 } } }
        ? -> { println("ERROR open ptx"); return 13 }
    }
    hmod<Int> = cuda_module_load(ptx)
    if (hmod == 0) { println("ERROR module load"); return 2 }
    hf<Int> = cuda_module_func(hmod, "accumulate_bucket")
    if (hf == 0) { println("ERROR missing accumulate_bucket"); return 3 }

    // --- the same ring CSR the pipeline runner builds -----------------------------------
    d_indptr<Int> = cuda_mem_alloc((n + 1) * 4)
    d_indices<Int> = cuda_mem_alloc(n * 3 * 4)
    d_syn<Int> = cuda_mem_alloc(n * 3 * 4)
    i<Int> = 0
    e<Int> = 0
    while (i <= n) {
        cuda_write_i32(d_indptr + i * 4, (i * 3) as CInt)
        i = i + 1
    }
    i = 0
    while (i < n) {
        inhib<Int> = i % 5
        k<Int> = 0
        while (k < 3) {
            d<Int> = 1
            if (k == 1) { d = 3 }
            if (k == 2) { d = 7 }
            tgt<Int> = (i + d) % n
            w<Int> = 3 + d
            if (inhib == 0) { w = 0 - w }
            cuda_write_i32(d_indices + e * 4, tgt as CInt)
            cuda_write_i32(d_syn + e * 4, w as CInt)
            e = e + 1
            k = k + 1
        }
        i = i + 1
    }

    // --- seed bucket, zero accumulator --------------------------------------------------
    d_src<Int> = cuda_mem_alloc(n_seed * 4)
    i = 0
    while (i < n_seed) {
        cuda_write_i32(d_src + i * 4, i as CInt)
        i = i + 1
    }
    d_accum<Int> = cuda_mem_alloc(n_slots * 8)
    i = 0
    while (i < n_slots) {
        cuda_write_f64(d_accum + i * 8, 0.0)
        i = i + 1
    }

    d_dsc<Int> = cuda_mem_alloc(64)
    desc_word(d_dsc, 0, d_accum)
    desc_word(d_dsc, 8, d_src)
    desc_word(d_dsc, 16, d_indptr)
    desc_word(d_dsc, 24, d_indices)
    desc_word(d_dsc, 32, d_syn)
    desc_word(d_dsc, 40, n)
    desc_word(d_dsc, 48, g_micro)

    r<CInt> = cuda_launch(hf, n_seed as CInt, 1, 1, 64 as CInt, 1, 1, d_dsc)
    ri<Int> = r as Int
    if (cuda_sync() != 0) { println("ERROR sync"); return 4 }
    println("accum_probe launch_rc=" + ri.to_string())

    out<String> = ""
    i = 0
    while (i < 18) {
        v<Float> = cuda_read_f64(d_accum + i * 8)
        micro<Int> = (v * 1000000.0) as Int
        out = out + i.to_string() + ":" + micro.to_string() + " "
        i = i + 1
    }
    println("accum_micro=" + out)
    println("expect      = 0:0 1:-80000 2:80000 3:-40000 4:200000 5:200000 6:40000 7:0 8:160000 "
            + "9:400000 10:400000 11:320000 12:0 13:200000 14:200000 15:200000 16:200000 17:0")
    println("accum-probe-done")
    return 0
}
